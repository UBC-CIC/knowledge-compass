*.js
!lambda/*.js
!lambda/*/*.js
!lambda/*/*/*.js
!jest.config.js
# CDK Lambda source lives under cdk/lambda; keep it tracked (patterns above are
# not anchored to the cdk/ subdir, so add cdk-anchored negations here).
!cdk/lambda/**/*.js
*.d.ts
node_modules

# CDK asset staging directory
.cdk.staging
cdk.out

# CDK context file contains sensitive account information
cdk.context.json


.kiro
.vscode

# ── Ingestion containers (cdk/containers) ───────────────────────────────────
# Local crawl/transcribe outputs — never commit scraped content dumps
crawl_output.json
vtt_output.json
cdk/containers/**/crawl_output.json
cdk/containers/**/vtt_output.json

# RDS CA bundle is fetched at runtime; do not commit downloaded copies
global-bundle.pem
cdk/containers/**/global-bundle.pem

# Local environment files (may hold DB endpoints / credentials)
.env
.env.*
!.env.example

new frontend

__pycache__/
*.py[cod]

# Evaluation harness: run output (transcripts, judge rationales) and its venv.
# Scenarios in evals/scenarios/ ARE committed.
evals/results/
evals/.venv/

.agents/tasks
.agents
.worktrees