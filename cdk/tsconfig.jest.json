{
  // ts-jest only: transpile each test file in isolation instead of building a
  // full type-checked program per suite, which exhausted the heap on the
  // CodeBuild UnitTests box when it was SMALL. Type checking is done by `tsc --noEmit` (main
  // tsconfig.json, which includes test/) in the step before jest.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true
  }
}
