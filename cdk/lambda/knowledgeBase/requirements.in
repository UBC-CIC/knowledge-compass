# These are NOT installed at deploy time — lambdaKnowledgeBase is a plain zip
# asset (see cdk/lib/api-stack.ts) with no Docker bundling step. Instead, the
# packages below are vendored directly into this directory (pypdf/, docx/,
# lxml/, typing_extensions.py, and matching *.dist-info folders) as prebuilt
# manylinux wheels, so deploying KC-Api never requires Docker.
#
# requirements.txt is generated from this file with every package pinned and
# hashed. After bumping a version here, regenerate it from the repo root:
#
#   uv pip compile cdk/lambda/knowledgeBase/requirements.in \
#     -o cdk/lambda/knowledgeBase/requirements.txt --generate-hashes \
#     --python-version 3.12 --python-platform x86_64-manylinux2014
#
# then re-vendor (works on any OS — these are precompiled wheels, nothing is
# locally compiled):
#
#   pip install --platform manylinux2014_x86_64 --implementation cp \
#     --python-version 3.12 --abi cp312 --only-binary=:all: --no-compile \
#     --no-deps --require-hashes --target cdk/lambda/knowledgeBase \
#     -r cdk/lambda/knowledgeBase/requirements.txt
#
# then commit the resulting package dirs + *.dist-info folders (and delete the
# old version's dist-info if the version changed).
# tests/test_vendored_requirements.py checks the pins and the vendored
# dist-info folders agree.
pypdf==6.19.0
python-docx==1.2.0
# Transitive (python-docx), pinned to what is vendored.
lxml==6.1.3
typing_extensions==4.16.0
