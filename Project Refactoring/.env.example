# Environment template for the Inclusion Canada RAG ingestion prototypes
# (crawler + transcriber). Copy to `.env` and fill in real values.
# NEVER commit a real .env — it is gitignored.
#
# Values here are examples/placeholders only. No real credentials.

# ── Required ──────────────────────────────────────────────────────────────
DB_HOST=your-rds-or-proxy-endpoint.example.rds.amazonaws.com
DB_NAME=KC
DB_USER=app_rw

# ── AWS region (falls back to us-east-1 if unset) ─────────────────────────
AWS_REGION=ca-central-1

# ── Credential mode: iam | secret | password (default: iam) ───────────────
# iam:      RDS IAM auth token generated at runtime (preferred, no stored secret)
# secret:   read password from Secrets Manager (set DB_SECRET_NAME)
# password: use DB_PASSWORD directly (local dev only)
DB_AUTH=iam

# Required only when DB_AUTH=secret
# DB_SECRET_NAME=KC/Database/AppRw

# Required only when DB_AUTH=password (local dev only)
# DB_PASSWORD=

# ── TLS ───────────────────────────────────────────────────────────────────
DB_PORT=5432
DB_SSLMODE=verify-full
# Download once, then point to it (kept out of git):
#   curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_ROOT_CERT=./global-bundle.pem

# ── Embeddings (optional overrides) ───────────────────────────────────────
EMBED_MODEL_ID=cohere.embed-english-v3
EMBED_BATCH_SIZE=96
